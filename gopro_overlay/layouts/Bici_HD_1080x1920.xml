<?xml version='1.0' encoding='utf-8'?>
<layout>

    <!-- Top bar centrado: Timer + Barra distancia + Valor -->
    <translate x="610" y="15">
        <frame width="700" height="35" bg="30,33,38" cr="10" opacity="0.8" />
        <component type="elapsed" x="17" y="3" size="21" align="left" />
        <translate x="85" y="15">
            <component type="bar" metric="odo" units="km" width="500" height="5" min="0" max="auto"
                outline-width="0" bar="255,255,255" h-pos="255,255,255" fill="120,120,120" zero="0,0,0,0" cr="3" />
        </translate>
        <translate x="625" y="5">
            <component type="metric" metric="odo" units="km" dp="1" size="18" align="right" />
        </translate>
        <translate x="640" y="5">
            <component type="text" x="0" size="18" align="left" rgb="160,160,160" outline="0,0,0,0"> / </component>
            <component type="metric" metric="odo" units="km" dp="1" x="18" size="18" align="left" stat="max" rgb="160,160,160" outline="0,0,0,0" />
            <component type="text" x="60" size="18" align="left" rgb="160,160,160" outline="0,0,0,0"> km</component>
        </translate>
    </translate>

    <!-- Métricas principales - lado izquierdo -->
    <translate x="40" y="40">

        <!-- FC Card -->
        <translate x="0" y="755">
            <frame width="310" height="110" bg="30,33,38" cr="10" opacity="0.8" />
            <!-- Fondo del icono -->
            <frame x="7" y="7" width="21" height="21" bg="234,57,67,255" cr="4" opacity="0.15" />
            <component type="icon" x="9" y="9" file="heartbeat.png" size="17" />
            <!-- Label FC -->
            <component type="text" x="33" y="8" size="11" align="left" rgb="180,180,180" outline="0,0,0,0">FREC. CARDÍACA</component>
            <!-- Valor FC -->
            <component type="metric" metric="hr" dp="0" x="27" y="18" size="30" align="left" />
            <!-- Unidad BPM -->
            <component type="text" x="80" y="31" size="12" align="left" rgb="234,57,67" outline="0,0,0,130">BPM</component>
            <!-- Zona dinámica -->
            <translate x="290" y="7">
                <component type="zone_name" metric="hr" z1="118" z2="137" z3="157" z4="176"
                    zone-0-name="Z1" zone-1-name="Z2" zone-2-name="Z3" zone-3-name="Z4" zone-4-name="Z5"
                    size="13" align="right" rgb="255,255,255" outline="0,0,0,130" />
            </translate>
            <translate x="297" y="22">
                <component type="zone_name" metric="hr" z1="118" z2="137" z3="157" z4="176"
                    zone-0-name="Rec." zone-1-name="Aeróbico" zone-2-name="Umbral" zone-3-name="Anaeróbico" zone-4-name="VO2"
                    size="11" align="right" rgb="200,200,200" outline="0,0,0,130" />
            </translate>
            <!-- Zone bar -->
            <translate x="6" y="55">
                <component type="zone-bar" metric="hr" min="90" max="194" z1="118" z2="137" z3="157" z4="176"
                    z0-rgb="26,158,92" z1-rgb="232,194,32" z2-rgb="224,120,32" z3-rgb="214,53,53" z4-rgb="180,30,30"
                    zone-divider="255,255,255" outline="0,0,0,0" width="297" height="10"
                    mode="solid" indicator="255,255,255" indicator-width="4" inactive-alpha="0.3"
                    zone-widths="12,25,25,19,19" outline-width="0" />
            </translate>
            <!-- Labels Z1-Z5 -->
            <component type="text" x="26" y="68" size="10" align="centre" rgb="26,158,92" outline="0,0,0,0">Z1</component>
            <component type="text" x="81" y="68" size="10" align="centre" rgb="232,194,32" outline="0,0,0,0">Z2</component>
            <component type="text" x="155" y="68" size="10" align="centre" rgb="224,120,32" outline="0,0,0,0">Z3</component>
            <component type="text" x="220" y="68" size="10" align="centre" rgb="214,53,53" outline="0,0,0,0">Z4</component>
            <component type="text" x="277" y="68" size="10" align="centre" rgb="180,30,30" outline="0,0,0,0">Z5</component>
        </translate>

        <!-- Gradient Card (arriba, ancho chico) -->
        <translate x="0" y="870">
            <frame width="152" height="68" bg="30,33,38" cr="10" opacity="0.8" />
            <frame x="6" y="6" width="19" height="19" bg="96,165,250,255" cr="3" opacity="0.15" />
            <component type="icon" x="8" y="8" file="slope-triangle.png" size="14" />
            <component type="text" x="28" y="7" size="9" align="left" rgb="180,180,180" outline="0,0,0,0">PENDIENTE</component>
            <component type="metric" metric="gradient" dp="1" x="28" y="19" size="24" align="left" />
            <component type="text" x="82" y="32" size="9" align="left" rgb="96,165,250" outline="0,0,0,130">DEG</component>
            <translate x="6" y="50">
                <component type="bar" metric="gradient" width="140" height="4" min="auto" max="auto"
                    outline-width="0" bar="96,165,250" h-pos="96,165,250" fill="120,120,120" zero="0,0,0,0" cr="2" />
            </translate>
        </translate>

        <!-- Cadence Card -->
        <translate x="158" y="870">
            <frame width="152" height="68" bg="30,33,38" cr="10" opacity="0.8" />
            <frame x="6" y="6" width="19" height="19" bg="167,139,250,255" cr="3" opacity="0.15" />
            <component type="icon" x="8" y="8" file="gauge.png" size="14" />
            <component type="text" x="28" y="7" size="9" align="left" rgb="180,180,180" outline="0,0,0,0">CADENCIA</component>
            <component type="metric" metric="cadence" dp="0" x="28" y="19" size="24" align="left" />
            <component type="text" x="82" y="32" size="9" align="left" rgb="167,139,250" outline="0,0,0,130">RPM</component>
            <translate x="6" y="50">
                <component type="bar" metric="cadence" width="140" height="4" min="0" max="auto"
                    outline-width="0" bar="167,139,250" h-pos="167,139,250" fill="120,120,120" zero="0,0,0,0" cr="2" />
            </translate>
        </translate>

        <!-- Speed Card (abajo, ancho grande) -->
        <translate x="0" y="942">
            <frame width="310" height="68" bg="30,33,38" cr="10" opacity="0.8" />
            <frame x="6" y="6" width="19" height="19" bg="249,115,22,255" cr="3" opacity="0.15" />
            <component type="icon" x="8" y="8" file="speedometer-variant-tool-symbol.png" size="14" />
            <component type="text" x="28" y="7" size="9" align="left" rgb="180,180,180" outline="0,0,0,0">VELOCIDAD</component>
            <component type="metric" metric="speed" units="kph" dp="0" x="28" y="19" size="24" align="left" />
            <component type="text" x="82" y="32" size="9" align="left" rgb="249,115,22" outline="0,0,0,130">KM/H</component>
            <translate x="6" y="50">
                <component type="bar" metric="speed" units="km/h" width="298" height="4" min="0" max="auto"
                    outline-width="0" bar="249,115,22" h-pos="249,115,22" fill="120,120,120" zero="0,0,0,0" cr="2" />
            </translate>
        </translate>

    </translate>

    <!-- Mapa -->
    <translate x="1500" y="15">
        <component type="cairo_circuit_map" size="400" fill="200,200,200" outline="0,0,0,0" line-width="0.012"
            loc-fill="234,57,67" loc-outline="255,255,255" loc-size="0.018" rotate="0" />
    </translate>

</layout>
